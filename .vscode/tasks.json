{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++ 编译多文件项目",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-o",
                "${workspaceFolder}/output/main.exe",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/MainWindow.cpp",
                "${workspaceFolder}/Graph.cpp",
                "${workspaceFolder}/Dijkstra.cpp",
                "${workspaceFolder}/OrderManager.cpp"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "编译所有源文件并链接生成可执行文件"
        }
    ]
}
